# ----------------------------------------------------------------------
# Hakemisto jonne ennusteet tallennetaan
# ----------------------------------------------------------------------

qdtext::outdir = <OUTDIR>

qdtext::forecasttime = <FORECASTTIME>

textgen::database = textgen2
qdtext::encoding = utf8

# ----------------------------------------------------------------------
# Ennustuspisteet
# ----------------------------------------------------------------------

qdtext
{
	areas = helsinki
	areas += imatra
	areas += ivalo
	areas += joensuu
	areas += kuopio
	areas += lahti
	areas += lappeenranta
	areas += oulu
	areas += pori
	areas += rauma
	areas += rovaniemi
	areas += tampere
	areas += turku
	areas += vaasa
	areas += viipuri
}


qdtext::dictionary = po
qdtext::timezone = Europe/Helsinki

qdtext::products = fi_txt,sv_txt,en_txt,fi_html,no_txt,da_txt,de_txt,fr_txt,it_txt,es_txt,et_txt,nl_txt,ru_txt,sw_txt,id_txt,ar_txt,vi_txt,zh_txt,ja_txt,ko_txt,th_txt

qdtext::product::fi_txt
{
	language = fi
	formatter = plainlines

	filename
	{
		helsinki	= fi-helsinki.txt
		imatra		= fi-imatra.txt
		ivalo		= fi-ivalo.txt
		joensuu		= fi-joensuu.txt
		kuopio		= fi-kuopio.txt
		lahti		= fi-lahti.txt
		lappeenranta	= fi-lappeenranta.txt
		oulu		= fi-oulu.txt
		pori		= fi-pori.txt
		rauma		= fi-rauma.txt
		rovaniemi	= fi-rovaniemi.txt
		tampere		= fi-tampere.txt
		turku		= fi-turku.txt
		vaasa		= fi-vaasa.txt
		viipuri		= fi-viipuri.txt
	}	
}

